<%= turbo_frame_tag "config_step" do %>
  <div class="bg-white rounded-xl shadow-sm border border-asafe-border p-8">
    <h2 class="text-2xl font-semibold text-asafe-dark mb-6"><%= group.name %></h2>
    <%= form_with url: product_configuration_path(product), method: :patch, local: false do |f| %>
      <%= f.hidden_field :option_group_id, value: group.id %>
      <div class="space-y-4">
        <% group.option_values.each do |value| %>
          <label class="flex items-center space-x-4 p-4 rounded-lg border border-asafe-border hover:bg-gray-50 cursor-pointer">
            <%= f.radio_button :option_value_id, value.id, class: "form-radio h-5 w-5 text-asafe-yellow" %>
            <span class="text-asafe-dark font-medium"><%= value.name %></span>
            <span class="text-asafe-gray text-sm"><%= value.price_modifier >= 0 ? "+" : "" %><%= number_to_currency(value.price_modifier) %></span>
          </label>
        <% end %>
      </div>
      <div class="mt-8">
        <%= f.submit "Next", class: "w-full bg-asafe-yellow text-white px-6 py-3 rounded-lg font-semibold hover:bg-asafe-yellow-hover cursor-pointer transition" %>
      </div>
    <% end %>
  </div>
<% end %>
