<%= turbo_frame_tag "config_step" do %>
  <div class="bg-white rounded-xl shadow-sm border border-asafe-border p-8">
    <h2 class="text-2xl font-semibold text-asafe-dark mb-4">Configuration Complete</h2>
    <p class="text-asafe-gray mb-8">All options selected. Please fill in your details to receive a quote.</p>
    <%= form_with url: product_quotes_path(@product), method: :post, local: false, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :customer_name, "Name", class: "block text-sm font-medium text-asafe-dark mb-1" %>
        <%= f.text_field :customer_name, required: true, class: "mt-1 block w-full rounded-lg border-asafe-border shadow-sm focus:border-asafe-yellow focus:ring-asafe-yellow px-4 py-3" %>
      </div>
      <div>
        <%= f.label :customer_email, "Email", class: "block text-sm font-medium text-asafe-dark mb-1" %>
        <%= f.email_field :customer_email, required: true, class: "mt-1 block w-full rounded-lg border-asafe-border shadow-sm focus:border-asafe-yellow focus:ring-asafe-yellow px-4 py-3" %>
      </div>
      <%= f.submit "Generate Quote", class: "w-full bg-asafe-yellow text-white px-6 py-3 rounded-lg font-semibold hover:bg-asafe-yellow-hover cursor-pointer transition" %>
    <% end %>
  </div>
<% end %>
