<div class="container mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold text-asafe-dark mb-8">Product Catalog</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @products.each do |product| %>
      <%= turbo_frame_tag "product_#{product.id}" do %>
        <div class="bg-white rounded-xl shadow-sm border border-asafe-border hover:shadow-md transition p-6 flex flex-col">
          <h2 class="text-xl font-semibold text-asafe-dark"><%= product.name %></h2>
          <p class="text-asafe-gray text-sm mt-1"><%= product.category %></p>
          <p class="text-3xl font-bold text-asafe-yellow mt-4"><%= number_to_currency(product.base_price) %></p>
          <div class="mt-auto pt-6">
            <%= link_to "View Details", product_path(product), 
                  class: "w-full block text-center bg-asafe-yellow text-white px-5 py-3 rounded-lg font-semibold hover:bg-asafe-yellow-hover transition",
                  data: { turbo_frame: "product_#{product.id}" } %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
