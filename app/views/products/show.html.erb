<%= turbo_frame_tag "product_#{@product.id}" do %>
  <div class="container mx-auto px-4 py-10">
    <div class="bg-white rounded-xl shadow-sm border border-asafe-border p-8 max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold text-asafe-dark mb-4"><%= @product.name %></h1>
      <p class="text-asafe-gray text-sm">Code: <%= @product.code %> | Category: <%= @product.category %></p>
      <p class="text-4xl font-bold text-asafe-yellow my-6"><%= number_to_currency(@product.base_price) %></p>

      <h2 class="text-xl font-semibold text-asafe-dark mt-8 mb-3">Options</h2>
      <ul class="space-y-4 mb-8">
        <% @product.option_groups.each do |group| %>
          <li>
            <p class="font-medium text-asafe-gray"><%= group.name %></p>
            <ul class="list-disc list-inside pl-4">
              <% group.option_values.each do |value| %>
                <li class="text-asafe-gray"><%= value.name %> (<%= number_to_currency(value.price_modifier) %>)</li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>

      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <%= link_to "Configure", new_product_configuration_path(@product), 
              class: "flex-1 text-center bg-asafe-yellow text-white px-6 py-3 rounded-lg font-semibold hover:bg-asafe-yellow-hover transition",
              data: { turbo: "false" } %>
        <%= link_to "Back to Catalog", products_path, 
              class: "flex-1 text-center bg-gray-200 text-asafe-dark px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition",
              data: { turbo: "false" } %>
      </div>

      <%# AI Suggestion section %>
      <%= render "ai_suggestions/suggestion_form", product: @product %>
    </div>
  </div>
<% end %>
