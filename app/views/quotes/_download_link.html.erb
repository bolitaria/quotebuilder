<%= turbo_frame_tag "config_step" do %>
  <div class="bg-white rounded-xl shadow-sm border border-asafe-border p-8 text-center">
    <h2 class="text-2xl font-semibold text-asafe-dark mb-4">Quote Ready!</h2>
    <p class="text-asafe-gray mb-8">Your quote has been generated successfully.</p>
    <%= link_to "Download PDF", quote_path(quote), 
          class: "inline-block bg-gray-200 text-asafe-dark px-8 py-3 rounded-lg font-semibold hover:bg-gray-300 transition", target: "_blank" %>
    <p class="text-sm text-asafe-gray mt-6">Quote total: <%= number_to_currency(quote.total_price) %></p>
  </div>
<% end %>
