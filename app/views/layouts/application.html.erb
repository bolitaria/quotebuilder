<!DOCTYPE html>
<html>
  <head>
    <title>QuoteBuilder</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind desde CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Colores corporativos A‑SAFE -->
    <style>
      .bg-asafe-dark { background-color: #1a1a1a; }
      .text-asafe-dark { color: #1a1a1a; }
      .bg-asafe-yellow { background-color: #f2a900; }
      .text-asafe-yellow { color: #f2a900; }
      .hover\:bg-asafe-yellow-hover:hover { background-color: #d18e00; }
      .border-asafe-border { border-color: #e5e7eb; }
      .bg-asafe-light { background-color: #f3f4f6; }
      .text-asafe-gray { color: #4b5563; }
      .focus\:border-asafe-yellow:focus { border-color: #f2a900; }
      .focus\:ring-asafe-yellow:focus { --tw-ring-color: #f2a900; }
    </style>
    <!-- Turbo + Stimulus desde CDN (unpkg) -->
    <script src="https://unpkg.com/@hotwired/turbo@8.0.3/dist/turbo.es2017-umd.js"></script>
    <script src="https://unpkg.com/@hotwired/stimulus@3.2.2/dist/stimulus.umd.js"></script>
  </head>
  <body class="bg-asafe-light text-asafe-dark">
    <nav class="bg-asafe-dark text-white p-4">
      <div class="container mx-auto flex justify-between items-center">
        <h1 class="text-xl font-bold tracking-tight">QuoteBuilder</h1>
      </div>
    </nav>
    <main class="container mx-auto mt-8 px-4">
      <%= yield %>
    </main>
  </body>
</html>
